# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pos_inventory

# How often (ms) the background sweeper checks for expired reservations
RESERVATION_SWEEP_INTERVAL_MS=15000

# Reservation lifetime in minutes (kept configurable for testing; spec = 5)
RESERVATION_MINUTES=5

# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
